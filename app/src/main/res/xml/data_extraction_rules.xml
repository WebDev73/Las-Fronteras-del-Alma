<?xml version="1.0" encoding="utf-8"?>
<!-- Learning history is personal; it is not included in cloud backups or device transfers.
     Learners use the in-app export instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
